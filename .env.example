# Copy relevant vars into apps/admin/.env.local, apps/blog/.env.local, scraper/.env
# Never commit real values.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cricket_blog?retryWrites=true&w=majority

# Gemini
GEMINI_API_KEY=

# Pexels — cover images (commercially licensed stock, credited on the article)
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Cloudinary — only needed for Gemini-generated covers (paid Gemini plan)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth.js (admin app)
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# Blog <-> Admin revalidation
REVALIDATE_SECRET=
BLOG_BASE_URL=http://localhost:3000

# GitHub Actions -> admin /api/generate trigger (also set as a GitHub repo secret)
CRON_SECRET=
